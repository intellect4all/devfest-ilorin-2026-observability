# Copy to .env (never committed) and fill in.

# Where alerts go. The audience subscribes to $NTFY_TOPIC in the ntfy app
# (make subscribe shows it with a QR code). Topics on ntfy.sh are public: anyone
# who knows the name can read and post. Make it short enough to type from the
# projector, and unusual enough that nobody else is already using it.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=devfest-ilorin-change-me

# Offline Plan B: `make ntfy-local`, then set NTFY_URL=http://ntfy; make subscribe
# then shows phones on the same hotspot the laptop's address.
# NTFY_URL=http://ntfy

# Host ports (change any that are taken on your machine).
GRAFANA_PORT=3000
PROM_PORT=9090
TEMPO_PORT=3200
LOKI_PORT=3100
OTLP_PORT=4318
PG_PORT=5432
TRANSFERS_PORT=8080
LEDGER_PORT=8081
PROVIDER_PORT=8082
RELAY_PORT=8090
NTFY_LOCAL_PORT=2586

# Traffic shape (see docs/RUNBOOK.md, "Calibration").
LOAD_RATE=20
LOAD_HOT=0.9
SURGE_RATE=80
SURGE_SECONDS=90
